# Скопируй этот файл в .env и подставь свои значения.

# Токен бота от @BotFather в Telegram
BOT_TOKEN=

# Ключ Claude из console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Локальный запуск: бот работает через polling, вебхук не ставится.
# На сервере (Amvera) — убрать или поставить false.
LOCAL_RUN=true

# --- Необязательное, у всего есть значения по умолчанию ---
# MODEL=claude-opus-5
# MAX_OUTPUT_TOKENS=8000
# EFFORT=high          # low | medium | high | xhigh | max — чем ниже, тем быстрее и дешевле
# WEBHOOK_URL=https://textoid-panarini.amvera.io
